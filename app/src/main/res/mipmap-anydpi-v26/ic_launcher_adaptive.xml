<?xml version="1.0" encoding="utf-8"?>
<!-- QR Time launcher icon for Android 8+: the system shapes it (circle, squircle...) on phones and tablets.
     Kept under its own name: the app icon picker draws the ic_launcher* PNGs with painterResource,
     which can't load adaptive icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
